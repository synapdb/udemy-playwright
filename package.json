{
  "name": "udemy-playwright",
  "version": "1.0.0",
  "description": "Automated software testing with Playwright",
  "main": "index.js",
  "scripts": {
    "tests:chrome": "playwright test --config=playwright.config.ts --project=chromium",
    "tests:firefox": "playwright test --config=playwright.config.ts --project=firefox",
    "tests:webkit": "playwright test --config=playwright.config.ts --project=webkit",
    "tests:all": "playwright test --config=playwright.config.ts",
    "tests:e2e": "playwright test --config=tests/e2e/e2e.config.ts --project=chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdb/udemy-playwright.git"
  },
  "author": "Yzabel",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/synapdb/udemy-playwright/issues"
  },
  "homepage": "https://github.com/synapdb/udemy-playwright#readme",
  "dependencies": {
    "@playwright/test": "1.61.1",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
